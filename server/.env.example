# Copy this file to .env and adjust values
PORT=3000

# IMPORTANT: change this. Used to view the /admin dashboard and /api/stats
ADMIN_TOKEN=change-me

# Restrict which origin may call the API (your GitHub Pages site)
# Use * to allow any origin (simpler, less safe)
ALLOWED_ORIGIN=*

# Optional: location of the SQLite database file. Defaults to ./visits.db in the server folder
# SQLITE_PATH=/data/visits.db