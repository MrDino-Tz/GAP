# Copy to .env and export values, or set them in your hosting dashboard
# Example: source .env
ADMIN_TOKEN=change-me
# Comma-separated list of allowed origins, or * for any
ALLOWED_ORIGIN=*
PORT=8000
# Optional: maximum requests per IP per minute
RATE_LIMIT_PER_MINUTE=25
# Optional: path to the SQLite database file
# SQLITE_PATH=/data/gap.db