# Copy to .env and export values, or set them in your hosting dashboard
# Example: source .env
ADMIN_TOKEN=change-me
# Comma-separated list of allowed origins, or * for any
ALLOWED_ORIGIN=*
PORT=8000
# Optional: maximum requests per IP per minute for visitor tracking
RATE_LIMIT_PER_MINUTE=25
# Optional: higher limit for GPA calculation endpoints (slider tools are chatty)
GPA_RATE_LIMIT_PER_MINUTE=120
# GAP Bot: Groq API key (KEEP SECRET - never put it in the frontend bundle)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq endpoint/model and the per-IP chat limit
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
CHAT_RATE_LIMIT_PER_MINUTE=20
# Optional: path to the SQLite database file
# SQLITE_PATH=/data/gap.db